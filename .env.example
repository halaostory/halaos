# Database
POSTGRES_USER=halaos
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=halaos
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=change_me_redis_password

# Auth
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=720h

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# HTTP
HTTP_PORT=80

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_RATE=5
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_API_RATE=100
RATE_LIMIT_API_WINDOW=1m

# AI (requires at least one provider key for AI chat)
AI_ENABLED=true
MINIMAX_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# AI Billing
BILLING_FREE_TIER_TOKENS=1000

# Email (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@halaos.com

# Employee lifecycle / government filing agent
# Required to store government portal credentials, MDM secrets and OTP answers (32-byte key, base64):
#   openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
# Public web URL used in self-onboarding and e-signature links
APP_BASE_URL=http://localhost:5173
# Private storage for prepared returns, portal screenshots and signed PDFs (never served publicly)
# GOV_FILES_DIR=./data/gov
# DOC_FILES_DIR=./data/documents
# Chromium for the browser channel (auto-detected on PATH if unset)
# CHROME_PATH=/usr/bin/chromium
# Demo: run `go run ./cmd/mockgov` and set this to try the browser agent end-to-end
# GOV_MOCK_PORTAL_URL=http://127.0.0.1:8091
# Staging only: redirect e-mail submissions (e.g. BIR eSubmission) to a test inbox
# GOV_EMAIL_OVERRIDE_TO=

# Edition (see docs/halapeople.md)
# APP_EDITION=people   # people (default) | suite (adds attendance, talent, engagement, analytics)
# PRODUCT_NAME=
# PRODUCT_TAGLINE=

# Single sign-on (OpenID Connect) callback; defaults to APP_BASE_URL + /api/v1/auth/oidc/callback
# OIDC_REDIRECT_URL=

# Push payroll journals straight to Xero / QuickBooks Online (register an app with each; redirect
# URL = APP_BASE_URL/api/v1/gl/xero/callback or /api/v1/gl/quickbooks/callback)
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_API_URL=https://sandbox-quickbooks.api.intuit.com

# Pay net salaries through a licensed payout partner (Xendit Batch Disbursements). Callback URL:
# APP_BASE_URL/api/v1/payouts/xendit/callback (set the same token in Xendit as XENDIT_CALLBACK_TOKEN)
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=
# XENDIT_API_URL=https://api.xendit.co

# Cross-border contractor payouts through Wise (Business account API token + profile ID)
# WISE_API_TOKEN=
# WISE_PROFILE_ID=
# WISE_API_URL=https://api.transferwise.com
# WISE_SOURCE_CURRENCY=PHP
